# Todo es opcional. Copia este archivo a .env para fijar valores por defecto.
PORT=3000
HOST=127.0.0.1

# Proveedores (también se pueden configurar desde Ajustes en la app)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1

# Elige el proveedor inicial: demo | ollama | openai-compatible | openrouter |
# gemini | groq | cli-opencode | cli-claude | cli-codex | cli-gemini | cli-custom
PROVIDER=demo
MODEL=

# Cuentas opcionales (correo y acceso social). Todo se puede dejar vacío.
# Registra como URL de redirección: http://127.0.0.1:3000/api/auth/callback/<proveedor>
ZOLEVA_AUTH_ENABLED=true
ZOLEVA_AUTH_EMAIL=true
ZOLEVA_SESSION_SECRET=
ZOLEVA_PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Respaldo manual opcional en tu propia nube (alternativa al respaldo de la cuenta)
ZOLEVA_CLOUD_URL=
ZOLEVA_CLOUD_TOKEN=
