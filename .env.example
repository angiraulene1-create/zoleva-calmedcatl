# Todo es opcional. Copia este archivo a .env para fijar valores por defecto.
PORT=3000
HOST=127.0.0.1

# Proveedores (también se pueden configurar desde Ajustes en la app)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1

# Elige el proveedor inicial: demo | ollama | openai-compatible | openrouter |
# gemini | groq | cli-opencode | cli-claude | cli-codex | cli-gemini | cli-custom
PROVIDER=demo
MODEL=
